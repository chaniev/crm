{
  "name": "gym-crm-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audit": "npm audit --audit-level=high",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/assert-production-excludes-catalog.mjs",
    "catalog:build": "tsc -b && vite build --config vite.catalog.config.ts",
    "catalog:dev": "vite --config vite.catalog.config.ts --open /catalog.html",
    "catalog:preview": "vite preview --config vite.catalog.config.ts --outDir dist-catalog",
    "catalog:test:e2e": "playwright test --config playwright.catalog.config.ts",
    "catalog:test:visual": "playwright test --config playwright.catalog.config.ts e2e/catalog/design-system-visual.spec.ts",
    "catalog:test:visual:update": "npm run catalog:test:visual -- --update-snapshots",
    "check": "npm run lint && npm run typecheck && npm run check:raw-colors && npm run check:raw-spacing && npm run check:user-facing-text && npm run test:unit && npm run build",
    "check:raw-colors": "node scripts/check-raw-colors.mjs",
    "check:raw-spacing": "node scripts/check-raw-spacing.mjs",
    "check:user-facing-text": "node scripts/check-user-facing-text.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:iphone": "playwright test --project=iphone-air-webkit --project=iphone-17-pro-max-webkit",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource/onest": "^5.2.11",
    "@mantine/core": "^9.0.2",
    "@mantine/form": "^9.0.2",
    "@mantine/hooks": "^9.0.2",
    "@mantine/notifications": "^9.0.2",
    "@tabler/icons-react": "^3.41.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.5"
  }
}
