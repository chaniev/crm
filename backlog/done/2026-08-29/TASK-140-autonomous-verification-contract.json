      }
    ],
    "smoke": [
      {
        "id": "runtime.backend-live",
        "command": ["curl", "-fsS", "http://127.0.0.1:{backend_port}/health/live"],
        "timeout_seconds": 30
      },
      {
        "id": "runtime.frontend-root",
        "command": ["curl", "-fsS", "http://127.0.0.1:{frontend_port}/"],
        "timeout_seconds": 30
      }
    ]
