{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=gym_crm;Username=gym_crm;Password=gym_crm"
  },
  "Persistence": {
    "ApplyMigrationsOnStartup": true,
    "FailStartupOnMigrationError": true
  },
  "BootstrapUser": {
    "Login": "headcoach",
    "FullName": "Главный тренер"
  },
  "Branding": {
    "ClubName": "Gym CRM"
  },
  "ClientPhoto": {
    "MaxUploadSizeBytes": 10485760,
    "StorageRootPath": "uploads/client-photos"
  },
  "ClientTelegram": {
    "Enabled": false,
    "BotToken": "",
    "BotUsername": "",
    "LinkTokenTtlMinutes": 30,
    "PollingIntervalSeconds": 2,
    "PollingTimeoutSeconds": 20,
    "BackoffSeconds": 10,
    "MaxUpdatesPerPoll": 50
  },
  "TechnicalLogging": {
    "Enabled": true,
    "DirectoryPath": "logs/technical",
    "FileNamePrefix": "gym-crm-api",
    "FileSizeLimitMb": 20,
    "RetentionDays": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
